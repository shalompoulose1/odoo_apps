<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_barcode_scan" model="ir.ui.view">
        <field name="name">sale.order.form.barcode.scan</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']" position="before">
                <widget name="barcode_scan_panel"/>
            </xpath>
        </field>
    </record>

</odoo>
